<div class="col mb-4">
  <article class="project-card">
    {% if project.img %}
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-card-img-link">
        {% include figure.liquid loading="eager" path=project.img alt="project thumbnail" class="project-card-img" %}
      </a>
    {% endif %}
    <div class="project-card-body">
      <h3 class="project-card-title">
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
      </h3>
      <p class="project-card-text">{{ project.description }}</p>
      {% if project.tags %}
        <div class="project-tags">
          {% for tag in project.tags %}
            <span class="project-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </article>
</div>
